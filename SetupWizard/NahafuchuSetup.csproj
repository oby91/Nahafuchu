<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Nahafuchu-Setup</AssemblyName>
    <RootNamespace>NahafuchuSetup</RootNamespace>
    <ApplicationIcon>..\Assets\Nahafuchu.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>Nahafuchu Setup</Product>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\dist\portable\Nahafuchu.exe" LogicalName="NahafuchuSetup.Payload.exe" />
    <EmbeddedResource Include="..\Packaging\Uninstall.ps1" LogicalName="NahafuchuSetup.Uninstall.ps1" />
  </ItemGroup>
</Project>

